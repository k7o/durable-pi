<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pilot.AgentHost</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- MAAI001: several HarnessAgentOptions members are marked evaluation-only. The pilot
         exercises them deliberately; ADR 0001 records the prerelease risk. -->
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.DurableTask" Version="1.16.0-preview.260922.1" />
  </ItemGroup>

  <!-- The harness is opt-in: -p:PilotHarness=true. It currently stalls durable runs; see
       FINDINGS.md. Keeping it behind a switch keeps the working pilot working. -->
  <ItemGroup Condition="'$(PilotHarness)' == 'true'">
    <PackageReference Include="Microsoft.Agents.AI.Harness" Version="1.26.0" />
  </ItemGroup>

  <!-- Without the harness, pin the pair the durable extension was compiled against.
       Letting the harness pull Agents.AI 1.26 / Extensions.AI 10.10 makes runs stall. -->
  <ItemGroup Condition="'$(PilotHarness)' != 'true'">
    <PackageReference Include="Microsoft.Agents.AI" Version="1.13.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DurableTask.Client.AzureManaged" Version="1.27.0" />
    <PackageReference Include="Microsoft.DurableTask.Worker.AzureManaged" Version="1.27.0" />
  </ItemGroup>

</Project>
